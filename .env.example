# StoryWeaver configuration: copy this file to ".env" and fill in your keys. Never commit ".env".
# Every service below has a free tier. Only GROQ_API_KEY is required.

# REQUIRED: the agents' language models and voice input (free: https://console.groq.com/keys)
GROQ_API_KEY=

# OPTIONAL: extra fallback models and expressive cloud voices (free: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# OPTIONAL: pictures with FLUX.2 [klein] / FLUX.1 [schnell] (free Cloudflare account, 10,000 neurons per day:
# dash.cloudflare.com → AI → Workers AI → "Use REST API" → create a token with the Workers AI template).
# Without them, pictures fall back to Pollinations and, last of all, to scenes painted in the browser.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# OPTIONAL: a Pollinations key (enter.pollinations.ai) for a more reliable third picture provider
POLLINATIONS_KEY=

# --- Optional tuning (defaults shown) -------------------------------------------------------------------
# STORYWEAVER_PORT=8000
# STORYWEAVER_STUDIO_WARMUP=false   # measure the on-device Kokoro voices at start-up (only worth it on a fast CPU)
# STORYWEAVER_KOKORO_MODEL_FILE=kokoro-v1.0.onnx
# STORYWEAVER_IMAGE_MODELS=@cf/black-forest-labs/flux-2-klein-4b,@cf/black-forest-labs/flux-1-schnell
# Model routing: an ordered, comma-separated fallback chain of provider:model for each agent role, e.g.
# STORYWEAVER_ROUTE_STORYTELLER=groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b,gemini:gemini-3.5-flash
